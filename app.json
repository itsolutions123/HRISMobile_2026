{
  "expo": {
    "name": "atWork",
    "slug": "HRISMobileApp",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bigtime.hrismobileapp.test",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "userInterfaceStyle": "light",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
